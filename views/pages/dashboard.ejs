<div class="max-w-6xl mx-auto px-4 py-8">
  <!-- Page Header -->
  <div class="mb-8">
    <h1 class="text-3xl font-light text-gray-500 mb-2">
      <span class="font-bold text-gray-900">Digital Depths</span>
    </h1>
    <p class="text-gray-400 text-lg">Your performance summary this week</p>
  </div>

  <div class="flex gap-6">
    <div class="basis-2/3 overflow-auto">
      <!-- Dashboard Card -->
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-8">
        <!-- Card Header -->
        <div class="flex justify-between items-start mb-8">
          <div>
            <h2 class="text-xl font-semibold text-[#1c3290] mb-2">Orders</h2>
            <!-- <h2 class="text-xl font-semibold text-[#1c3290] mb-2">
              Today's Confirmed Orders
            </h2> -->
            <p class="text-gray-400 text-sm">Real-time Amazon Purchase Sync</p>
          </div>
          <div>
            <button
              id="downloadOrdersBtn"
              disabled
              class="bg-blue-800 hover:bg-blue-900 text-white text-sm font-semibold py-2 px-4 rounded-md shadow-sm transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
              onclick="exportToExcel()"
            >
              Download Orders in Excel
            </button>
          </div>
        </div>

        <!-- Orders Dashboard Card -->
        <div
          class="bg-white rounded-xl shadow-sm border border-gray-100 p-8 w-full"
        >
          <!-- Table Wrapper (Handles both X and Y scrolling) -->
          <div class="max-h-90 overflow-auto border border-gray-100 rounded-lg">
            <table class="w-full text-sm text-left">
              <thead
                class="text-xs text-gray-500 uppercase bg-gray-50 sticky top-0 z-10 shadow-sm"
              >
                <tr>
                  <th
                    scope="col"
                    class="px-6 py-4 font-semibold tracking-wider"
                  >
                    Order ID
                  </th>
                  <th
                    scope="col"
                    class="px-6 py-4 font-semibold tracking-wider"
                  >
                    Product Details
                  </th>
                  <th
                    scope="col"
                    class="px-6 py-4 font-semibold tracking-wider"
                  >
                    Customer
                  </th>
                  <th
                    scope="col"
                    class="px-6 py-4 font-semibold tracking-wider"
                  >
                    Total Price
                  </th>
                  <th
                    scope="col"
                    class="px-6 py-4 font-semibold tracking-wider text-right"
                  >
                    Status
                  </th>
                </tr>
              </thead>
              <tbody
                id="ordersListContainer"
                class="bg-white divide-y divide-gray-100"
              >
                <!-- Default Loading State -->
                <tr>
                  <td colspan="5" class="px-6 py-10 text-center">
                    <div
                      class="flex justify-center items-center space-x-3 text-gray-500"
                    >
                      <svg
                        class="animate-spin h-6 w-6 text-indigo-400"
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                      >
                        <circle
                          class="opacity-25"
                          cx="12"
                          cy="12"
                          r="10"
                          stroke="currentColor"
                          stroke-width="4"
                        ></circle>
                        <path
                          class="opacity-75"
                          fill="currentColor"
                          d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                        ></path>
                      </svg>
                      <span class="text-sm"
                        >Awaiting active transaction push...</span
                      >
                    </div>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
    <div class="basis-1/3 flex flex-col gap-6">
      <!-- Dashboard Card -->
      <div
        class="bg-white rounded-xl shadow-sm border border-gray-100 p-8 min-w-md"
      >
        <!-- Card Header -->
        <div class="flex justify-between items-start mb-8">
          <div>
            <h2 class="text-xl font-semibold text-[#1c3290] mb-2">
              Live Email Automation Queue
            </h2>
          </div>
        </div>

        <!-- Dynamic List Container -->
        <div
          id="queueListContainer"
          class="space-y-3 max-h-80 overflow-y-auto pr-2"
        >
          <!-- Default Loading State -->
          <div class="flex items-center space-x-3 text-gray-500 py-4">
            <svg
              class="animate-spin h-5 w-5 text-blue-600"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
            >
              <circle
                class="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                stroke-width="4"
              ></circle>
              <path
                class="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
              ></path>
            </svg>
            <span class="text-sm">Awaiting active transaction push...</span>
          </div>
        </div>
      </div>
      <div
        class="bg-white rounded-xl shadow-sm border border-gray-100 p-8 min-w-md"
      >
        <form id="getCardDetails">
          <div class="flex justify-between items-start mb-8">
            <div>
              <h2 class="text-xl font-semibold text-[#1c3290] mb-2">
                Get Card Details
              </h2>
            </div>
            <div>
            <button
            type="button"
              id="downloadCarddatabtn"
              class="bg-blue-800 hover:bg-blue-900 text-white text-sm font-semibold py-2 px-4 rounded-md shadow-sm transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
              onclick="exportCardDataToExcel()"
            >
              Download Card Data in Excel
            </button>
          </div>
          </div>
          <div class="mb-4">
            <label
              for="emailInput"
              class="block text-sm font-medium text-gray-700 mb-1"
              >Email</label
            >
            <input
              type="email"
              id="emailInput"
              name="emailInput"
              required
              placeholder="Enter email"
              class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            />
          </div>
          <div class="mb-4">
            <label
              for="monthsInput"
              class="block text-sm font-medium text-gray-700 mb-1"
              >Months</label
            >
            <select
              id="monthsInput"
              name="monthsInput"
              required
              class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            >
              <option value="january">January</option>
              <option value="february">February</option>
              <option value="march">March</option>
              <option value="april">April</option>
              <option value="may">May</option>
              <option value="june">June</option>
              <option value="july">July</option>
              <option value="august">August</option>
              <option value="september">September</option>
              <option value="october">October</option>
              <option value="november">November</option>
              <option value="december">December</option>
            </select>
          </div>
          <button
            type="submit"
            class="bg-blue-800 hover:bg-blue-900 text-white text-sm font-semibold py-2 px-4 rounded-md shadow-sm transition-colors"
          >
            Fetch Card Details
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Import SheetJS for Excel export -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

<!-- Import Socket.io -->
<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();

  // 1. Function to fetch emails and populate the queue
  async function loadEmailQueue() {
    const container = document.getElementById('queueListContainer');

    // Show loading state
    container.innerHTML = `
      <div class="flex items-center space-x-3 text-gray-500 py-4">
          <svg class="animate-spin h-5 w-5 text-blue-600" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
          </svg>
          <span class="text-sm">Fetching accounts from database...</span>
      </div>
    `;

    try {
      const response = await fetch('/api/get-all-mails');
      const data = await response.json();

      if (data.success && data.emails.length > 0) {
        container.innerHTML = ''; // Clear loading spinner

        data.emails.forEach(item => {
          const row = document.createElement('div');
          row.className = 'flex justify-between items-center p-3 bg-gray-50 rounded-lg border border-gray-200';
          row.innerHTML = `
            <div class="flex flex-col truncate pr-3">
                <span class="text-sm font-semibold text-gray-800 truncate">${item.email}</span>
                <span class="text-xs text-gray-500">${item.status}</span>
            </div>
            <div class="flex items-center space-x-2">
                <!-- Delete Cross Button -->
                <button
                  onclick="deleteAccount('${item.email}')"
                  title="Delete Account"
                  class="p-1.5 text-gray-400 hover:text-red-600 hover:bg-red-100 rounded-md transition-colors"
                >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
                <!-- Sign in Button -->
                <button
                  onclick="triggerSavedSignIn('${item.email}')"
                  class="bg-blue-800 hover:bg-blue-900 text-white text-xs font-semibold py-1.5 px-4 rounded-md shadow-sm transition-colors whitespace-nowrap"
                >
                    Sign in
                </button>
            </div>
          `;
          container.appendChild(row);
        });
      } else {
        container.innerHTML = `<div class="text-gray-500 text-sm py-4">No accounts found in database.</div>`;
      }
    } catch (error) {
      container.innerHTML = `<div class="text-red-500 text-sm py-4">Failed to load emails. Check console.</div>`;
      console.error("Queue Load Error:", error);
    }
  }

  // 2. NEW FUNCTION: Delete account from Database
  async function deleteAccount(email) {
    if (!confirm(`Are you sure you want to delete ${email} from database?`)) {
      return;
    }

    try {
      const response = await fetch('/api/delete-email', {
        method: 'DELETE',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ email: email })
      });

      const data = await response.json();

      if (data.success) {
        // Refresh the list after deletion
        loadEmailQueue();
      } else {
        alert(data.message || 'Failed to delete account.');
      }
    } catch (error) {
      console.error("Delete Error:", error);
      alert('Error deleting account. Check console.');
    }
  }

  // 3. Function triggered when a user clicks "Sign in" on the list
  function triggerSavedSignIn(email) {
    const logConsole = document.getElementById('log-console');
    if (logConsole) logConsole.innerHTML = '';

    console.log(`Triggering sign in for: ${email}`);
    socket.emit('trigger-saved-signin', { email: email });
  }

  // 4. Event Listener for the Refresh Button
  const refreshBtn = document.getElementById('refreshQueueBtn');
  if (refreshBtn) {
    refreshBtn.addEventListener('click', loadEmailQueue);
  }

  // 5. Automatically load queue and orders on page load
  window.addEventListener('DOMContentLoaded', () => {
    loadEmailQueue();
  });

  async function loadOrdersDashboard() {
    const container = document.getElementById('ordersListContainer');

    try {
      const response = await fetch('/api/orders');
      const data = await response.json();

      if (data.success && data.orders.length > 0) {
        container.innerHTML = '';

        data.orders.forEach(order => {
          let statusColor = 'text-gray-600';
          if (order.status.toLowerCase().includes('success')) statusColor = 'text-green-600';
          if (order.status.toLowerCase().includes('failed')) statusColor = 'text-red-600';

          const row = document.createElement('tr');
          row.className = 'hover:bg-gray-50 transition-colors';

          row.innerHTML = `
              <td class="px-6 py-4 whitespace-nowrap font-medium text-gray-800">
                  ${order.orderId}
              </td>
              <td class="px-6 py-4 text-gray-600 max-w-[250px] truncate" title="${order.productName}">
                  ${order.productName}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-gray-500">
                  ${order.email}
              </td>
              <td class="px-6 py-4 whitespace-nowrap font-medium text-gray-700">
                  ${order.price}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right font-semibold ${statusColor}">
                  ${order.status}
              </td>
          `;
          container.appendChild(row);
        });
        document.getElementById('downloadOrdersBtn').disabled = false;
      } else {
        container.innerHTML = `
          <tr>
              <td colspan="5" class="px-6 py-8 text-center text-sm text-gray-400">
                  No orders found in database.
              </td>
          </tr>
      `;
      }
    } catch (error) {
      container.innerHTML = `<div class="text-red-400 text-sm text-center py-8">Failed to sync orders.</div>`;
    }
  }


  async function exportToExcel(ordersArray) {
    const response = await fetch('/api/orders');
    const data = await response.json();

    if (data.success && data.orders.length > 0) {
      // 1. Map your data to ensure the Excel columns look clean
      const cleanData = data.orders.map(order => ({
        "Order ID": order.orderId || "N/A",
        "Product Name": order.productName || "N/A",
        "Email": order.email || "N/A",
        "Price": order.price || "0",
        "Status": order.status || "Pending"
      }));

      // 2. Convert the JSON array to an Excel worksheet
      const worksheet = XLSX.utils.json_to_sheet(cleanData);

      // 3. Create a new Excel workbook and append the worksheet
      const workbook = XLSX.utils.book_new();
      XLSX.utils.book_append_sheet(workbook, worksheet, "Orders Data");

      // 4. Trigger the download!
      XLSX.writeFile(workbook, "DigitalDepths_Orders.xlsx");
    } else {
      alert("No orders available to export.");
    }
  }

  async function exportCardDataToExcel() {
    const response = await fetch('/api/get-card-details');
    const data = await response.json();
    console.log("Fetched Card Details:", data);

    if (data.success && data.cardDetails && data.cardDetails.length > 0) {
  // Map card-details data for clean Excel export / display
  const cleanData = data.cardDetails.map((item) => ({
    "Doc ID": item.id || "N/A",
    "Email": item.email || "N/A",
    "Amount": item.amount || "N/A",
    "Card Digits": item.cardDetails || "N/A",
    "Order ID(s)": item.orderIds || "N/A",
    "Product Name": item.productName || "N/A",
    "Statement Month": item.statementMonth || "N/A",
    "Status": item.status || "Pending",
    "Order Date": item.orderDate || "N/A",
    "Expected Credit Date": item.expectedCreditDate || "N/A",
    "Type": item.type || "Transaction Detail",
    "Created At": item.createdAt ? new Date(item.createdAt).toLocaleString() : "N/A",
  }));

      // 2. Convert the JSON array to an Excel worksheet
      const worksheet = XLSX.utils.json_to_sheet(cleanData);

      // 3. Create a new Excel workbook and append the worksheet
      const workbook = XLSX.utils.book_new();
      XLSX.utils.book_append_sheet(workbook, worksheet, "Orders Data");

      // 4. Trigger the download!
      XLSX.writeFile(workbook, "DigitalDepths_CardsDetails.xlsx");
    } else {
      alert("No card details available to export.");
    }
  }


  document.getElementById('getCardDetails').addEventListener('submit', (e) => {
    e.preventDefault();

    // Grab the text from the input fields
    const email = document.getElementById('emailInput').value.trim();
    const targetMonth = document.getElementById('monthsInput').value.trim();

    // Validate inputs
    if (!email || !targetMonth) {
      alert("Please enter both Email and Month before proceeding.");
      return;
    }

    // Send the data TO the server matching the exact event name in Step 2
    console.log("Sending data to server...", {email, targetMonth});
    socket.emit('trigger-get-card-details', { email: email, targetMonth: targetMonth });
  });


  // Auto-load orders and set interval for sync
  window.addEventListener('DOMContentLoaded', () => {
    loadOrdersDashboard();
    setInterval(loadOrdersDashboard, 15000);
  });


</script>
